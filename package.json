{
  "name": "ohnana",
  "version": "0.2.0",
  "type": "module",
  "description": "A meta-framework for Hono with plugin system and TypeScript inference",
  "author": "Juan José Monsalve Orozco <devlemonsalve@gmail.com> (https://github.com/lemonsalve)",
  "bin": {
    "ohnana": "src/cli/index.ts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemonsalve/ohnana.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "homepage": "https://hono.dev",
  "keywords": [
    "hono",
    "ohnana",
    "typescript",
    "plugin",
    "framework"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./plugins": "./src/plugins/index.ts",
    "./toolkit": "./src/toolkit/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.10",
    "hono": "^4.11.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
